(function () {
  'use strict';
  var $ = function (s) { return document.querySelector(s); };
  var state = { agents: [], selected: null, clients: [] };

  // Build DOM safely: text is always set with textContent, never innerHTML.
  function h(tag, attrs) {
    var el = document.createElement(tag);
    if (attrs) Object.keys(attrs).forEach(function (k) {
      if (k === 'class') el.className = attrs[k];
      else if (k === 'onclick') el.addEventListener('click', attrs[k]);
      else el.setAttribute(k, attrs[k]);
    });
    for (var i = 2; i < arguments.length; i++) {
      var c = arguments[i];
      if (c == null || c === false) continue;
      el.appendChild(typeof c === 'string' ? document.createTextNode(c) : c);
    }
    return el;
  }

  function toast(msg) {
    var t = $('#toast'); t.textContent = msg; t.style.display = 'block';
    clearTimeout(toast.t); toast.t = setTimeout(function () { t.style.display = 'none'; }, 4000);
  }

  function api(method, path, body) {
    var headers = { 'Content-Type': 'application/json' };
    var tok = $('#token').value.trim(), who = $('#actor').value.trim();
    if (tok) headers['Authorization'] = 'Bearer ' + tok;
    if (who) headers['X-Actor'] = who;
    return fetch('/api' + path, { method: method, headers: headers, body: body ? JSON.stringify(body) : undefined })
      .then(function (r) {
        return r.json().catch(function () { return {}; }).then(function (j) {
          if (!r.ok) { var e = new Error(j.error || ('Request failed (' + r.status + ')')); e.status = r.status; throw e; }
          return j;
        });
      });
  }
  function fail(e) { toast(e.message); }

  function loadHealth() {
    api('GET', '/health').then(function (j) {
      var p = $('#llm');
      p.textContent = j.llm === 'live' ? 'Live model: ' + j.model : 'Mock mode (no API key)';
      p.className = 'pill' + (j.llm === 'live' ? '' : ' mock');
    }).catch(fail);
  }

  function loadClients() {
    return api('GET', '/clients').then(function (cs) {
      state.clients = cs;
      var sel = $('#client'), cur = sel.value;
      sel.textContent = '';
      sel.appendChild(h('option', { value: '' }, 'All clients'));
      cs.forEach(function (c) { sel.appendChild(h('option', { value: c.id }, c.name)); });
      sel.value = cur;
    });
  }

  function loadList() {
    var p = new URLSearchParams();
    ['q', 'kind', 'client', 'status', 'sort'].forEach(function (k) { var v = $('#' + k).value; if (v) p.set(k, v); });
    return api('GET', '/agents?' + p.toString()).then(function (list) {
      state.agents = list;
      var rows = $('#rows'); rows.textContent = '';
      $('#count').textContent = list.length + (list.length === 1 ? ' entry' : ' entries');
      list.forEach(function (a) {
        var sub = [a.kind === 'template' ? 'Library template' : (a.client ? a.client.name : 'Unassigned'), a.status, 'v' + a.version]
          .concat(a.readiness == null ? [] : [a.readiness + '/6 ready']).join('  |  ');
        rows.appendChild(h('button', { class: 'row' + (state.selected === a.id ? ' sel' : ''), onclick: function () { select(a.id); } },
          h('b', null, a.name + (a.templateUpdated ? '  (template updated)' : '')), h('small', null, sub)));
      });
      var st = $('#status');
      if (st.options.length < 2) {
        ['Concept', 'In build', 'In test', 'Demo ready', 'Draft', 'Published', 'Retired'].forEach(function (s) { st.appendChild(h('option', { value: s }, s)); });
      }
    });
  }

  function select(id) {
    state.selected = id;
    loadList().catch(fail);
    Promise.all([api('GET', '/agents/' + encodeURIComponent(id)), api('GET', '/agents/' + encodeURIComponent(id) + '/reviews')])
      .then(function (r) { renderDetail(r[0], r[1]); }).catch(fail);
  }

  function section(title, node) { return h('div', null, h('h3', null, title), node); }
  function para(t, fallback) { return h('p', t ? null : { class: 'muted' }, t || fallback); }

  function renderDetail(a, reviews) {
    var d = $('#detail'); d.textContent = '';
    var card = h('div', { class: 'card' });
    card.appendChild(h('h2', null, a.name));
    card.appendChild(h('div', { class: 'meta' }, [a.kind === 'template' ? 'Library template' : (a.client ? a.client.name : 'Unassigned'), a.domain, a.status, 'v' + a.version, 'Updated ' + a.updated].join('  |  ')));

    var actions = h('div', { class: 'actions' });
    if (a.kind === 'agent') actions.appendChild(h('button', { class: 'primary', onclick: function () { runReview(a); } }, 'Run a review'));
    actions.appendChild(h('button', { onclick: function () { tailor(a); } }, 'Tailor for a client'));
    if (a.templateUpdated) actions.appendChild(h('button', { onclick: function () { act('POST', '/agents/' + a.id + '/mark-reviewed', null, a.id); } }, 'Mark template changes as reviewed'));
    actions.appendChild(h('button', { onclick: function () { act('POST', '/agents/' + a.id + (a.status === 'Retired' ? '/restore' : '/retire'), null, a.id); } }, a.status === 'Retired' ? 'Restore' : 'Retire'));
    card.appendChild(actions);

    if (a.templateUpdated) card.appendChild(h('p', { class: 'flag' }, 'The template is now v' + a.latestBaseVersion + '. This agent was tailored from v' + a.baseVersion + '.'));
    card.appendChild(section('Summary', para(a.summary, 'No summary yet.')));
    card.appendChild(section('Scenario', para(a.scenario, 'Not defined yet.')));
    card.appendChild(section('What the agent does', para(a.agentDoes, 'Not defined yet.')));
    card.appendChild(section('Hard rule', a.hardRule ? h('p', { class: 'rule' }, a.hardRule) : para('', 'No hard rule written yet.')));

    var src = h('ul', { class: 'plain' });
