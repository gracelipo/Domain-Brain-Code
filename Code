    card.appendChild(section('SMEs and points of contact', a.contacts.length ? con : para('', 'No SMEs or points of contact named yet.')));

    var gov = h('div', { class: 'gov' });
    ['Cites every source', 'Logs every action', 'Human approves first', 'Says "I don\'t know"'].forEach(function (g) { gov.appendChild(h('div', null, g)); });
    card.appendChild(section('Built-in governance (always on)', gov));

    if (a.kind === 'agent') {
      var ck = h('ul', { class: 'plain' });
      a.checks.forEach(function (c) { ck.appendChild(h('li', { class: c.ok ? 'ok' : 'no' }, (c.ok ? 'Done: ' : 'To do: ') + c.label)); });
      card.appendChild(section('Demo readiness (' + a.readiness + ' of 6)', ck));
      card.appendChild(h('p', null, 'Test set: ' + a.testSetCount + ' of 30 to 50 questions'));
    }
    if (a.kind === 'template' && a.usedBy) {
      var ub = h('ul', { class: 'plain' });
      a.usedBy.forEach(function (u) { ub.appendChild(h('li', null, u.name + (u.needsReview ? '  (needs review)' : '  (up to date)'))); });
      card.appendChild(section('Used by', a.usedBy.length ? ub : para('', 'No agents built from this template yet.')));
    }

    if (a.kind === 'agent') {
      var rv = h('div');
      reviews.forEach(function (r) { rv.appendChild(reviewCard(r, a)); });
