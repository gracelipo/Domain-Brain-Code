package com.domainbrain.registry;

import java.util.*;
import java.util.stream.Collectors;

/** Business rules for the registry: validation, readiness, versioning, tailoring, import and export. */
final class Registry {
    static final List<String> STATUS_AGENT = List.of("Concept", "In build", "In test", "Demo ready", "Retired");
    static final List<String> STATUS_TPL = List.of("Draft", "Published", "Retired");
    static final List<String> STATUS_ORDER = List.of("Concept", "Draft", "In build", "In test", "Published", "Demo ready", "Retired");
    static final List<String> DEPTHS = List.of("Deep build", "Thin build", "Scope tbc");
    static final List<String> PHASES = List.of("Days 1-30", "Days 31-60", "Days 61-90");

    record Check(String label, boolean ok) {}

    private final Store store;

    Registry(Store store) { this.store = store; }

    /* ---------- readiness ---------- */

    static List<Check> checks(Agent a) {
        return List.of(
                new Check("Public sources listed", !a.sources.isEmpty()),
                new Check("Named approver role set", !a.approverRole.isBlank()),
                new Check("Hard rule written", !a.hardRule.isBlank()),
                new Check("Test set of 30 or more questions", a.testSetCount >= 30),
                new Check("Agent harness stood up", a.harnessAgent),
                new Check("Evaluation harness stood up", a.harnessEval));
    }

    static int readiness(Agent a) {
        if (a.isTemplate()) return -1;
        return (int) checks(a).stream().filter(Check::ok).count();
    }

    Agent baseNewer(Agent a) {
        if (a.baseId.isBlank()) return null;
        Agent b = store.agents.get(a.baseId);
        return b != null && Util.vcmp(b.version, a.baseVersion) > 0 ? b : null;
    }

    private void requireDemoReady(Agent a) {
        if (a.isTemplate() || !"Demo ready".equals(a.status)) return;
        List<String> missing = checks(a).stream().filter(c -> !c.ok()).map(c -> c.label().toLowerCase(Locale.ROOT)).toList();
        if (!missing.isEmpty()) throw new ApiException(422, "Not ready for demo yet. Missing: " + String.join(", ", missing) + ".");
    }

    /* ---------- reads ---------- */

    Agent agent(String id) {
        Agent a = store.agents.get(Util.requireId(id));
        if (a == null) throw new ApiException(404, "Agent not found");
        return a;
    }

    Client client(String id) {
        Client c = store.clients.get(Util.requireId(id));
        if (c == null) throw new ApiException(404, "Client not found");
        return c;
    }

    Map<String, Object> view(Agent a) {
        Map<String, Object> m = a.toMap();
        Client c = store.clients.get(a.clientId);
        m.put("client", c == null ? null : Agent.orderedMap("id", c.id, "name", c.name));
        int r = readiness(a);
        m.put("readiness", r < 0 ? null : r);
        List<Object> cl = new ArrayList<>();
        if (!a.isTemplate()) for (Check k : checks(a)) cl.add(Agent.orderedMap("label", k.label(), "ok", k.ok()));
        m.put("checks", cl);
        Agent nb = baseNewer(a);
        m.put("templateUpdated", nb != null);
        m.put("latestBaseVersion", nb == null ? null : nb.version);
        m.put("differsFromBase", differs(a));
        if (a.isTemplate()) {
            List<Object> used = new ArrayList<>();
            for (Agent x : store.agents.values()) {
                if (a.id.equals(x.baseId)) {
                    used.add(Agent.orderedMap("id", x.id, "name", x.name, "clientId", x.clientId,
                            "needsReview", Util.vcmp(a.version, x.baseVersion) > 0));
                }
            }
            m.put("usedBy", used);
        }
        m.put("governance", Agent.governance());
        return m;
    }

    private List<String> differs(Agent a) {
        List<String> out = new ArrayList<>();
        Agent b = a.baseId.isBlank() ? null : store.agents.get(a.baseId);
        if (b == null) return out;
        if (!a.name.equals(b.name)) out.add("name");
        if (!a.summary.equals(b.summary)) out.add("summary");
        if (!a.scenario.equals(b.scenario)) out.add("scenario");
        if (!a.agentDoes.equals(b.agentDoes)) out.add("agentDoes");
        if (!a.hardRule.equals(b.hardRule)) out.add("hardRule");
        if (!a.approverRole.equals(b.approverRole)) out.add("approverRole");
        if (!a.dataPolicy.equals(b.dataPolicy)) out.add("dataPolicy");
        if (!names(a).equals(names(b))) out.add("sources");
        return out;
    }

    private static String names(Agent a) {
        return a.sources.stream().map(Agent.Source::name).collect(Collectors.joining(";"));
    }

    /** Filtered, searched and sorted listing. */
    List<Map<String, Object>> list(Map<String, String> q) {
        String kind = q.getOrDefault("kind", "agent");
        String client = q.get("client"), status = q.get("status"), domain = q.get("domain"), depth = q.get("depth");
        String text = q.getOrDefault("q", "").toLowerCase(Locale.ROOT).strip();
        boolean retired = "true".equals(q.get("includeRetired")) || "Retired".equals(status);
        List<Agent> out = new ArrayList<>();
        for (Agent a : store.agents.values()) {
            if (!"all".equals(kind) && !kind.equals(a.kind)) continue;
            if (!retired && "Retired".equals(a.status)) continue;
            if (client != null && !client.isBlank() && !client.equals(a.clientId)) continue;
            if (status != null && !status.isBlank() && !status.equals(a.status)) continue;
            if (domain != null && !domain.isBlank() && !domain.equals(a.domain)) continue;
            if (depth != null && !depth.isBlank() && !depth.equals(a.depth)) continue;
            if (!text.isEmpty() && !haystack(a).contains(text)) continue;
            out.add(a);
        }
        String key = q.getOrDefault("sort", "updated");
        boolean asc = "asc".equals(q.getOrDefault("dir", "updated".equals(key) || "readiness".equals(key) ? "desc" : "asc"));
        Comparator<Agent> cmp = switch (key) {
            case "name" -> Comparator.comparing((Agent a) -> a.name.toLowerCase(Locale.ROOT));
            case "client" -> Comparator.comparing((Agent a) -> clientName(a).toLowerCase(Locale.ROOT));
            case "status" -> Comparator.comparingInt((Agent a) -> STATUS_ORDER.indexOf(a.status));
            case "depth" -> Comparator.comparingInt((Agent a) -> DEPTHS.indexOf(a.depth));
            case "readiness" -> Comparator.comparingInt(Registry::readiness);
            case "version" -> (Agent a, Agent b) -> Util.vcmp(a.version, b.version);
            default -> Comparator.comparing((Agent a) -> a.updated);
        };
        cmp = cmp.thenComparing(a -> a.name.toLowerCase(Locale.ROOT));
        if (!asc) cmp = cmp.reversed();
        out.sort(cmp);
        List<Map<String, Object>> res = new ArrayList<>();
        for (Agent a : out) res.add(view(a));
        return res;
    }

    private String clientName(Agent a) {
        Client c = store.clients.get(a.clientId);
        return c == null ? "~" : c.name;
    }

    private String haystack(Agent a) {
        StringBuilder sb = new StringBuilder();
        sb.append(a.name).append(' ').append(a.summary).append(' ').append(a.domain).append(' ').append(a.approverRole).append(' ')
                .append(clientName(a)).append(' ').append(String.join(" ", a.tags)).append(' ').append(names(a));
        for (Agent.Contact c : a.contacts) sb.append(' ').append(c.name()).append(' ').append(c.title());
        return sb.toString().toLowerCase(Locale.ROOT);
    }

    /* ---------- validation ---------- */

    void validate(Agent a) { validate(a, store.clients.keySet()); }

    void validate(Agent a, Set<String> clientIds) {
        if (a.id == null || !Util.ID.matcher(a.id).matches()) throw new ApiException(400, "Invalid id");
        if (a.name.isBlank()) throw new ApiException(400, "Name is required");
        if (a.name.length() > 200) throw new ApiException(400, "Name is too long");
        List<String> statuses = a.isTemplate() ? STATUS_TPL : STATUS_AGENT;
        if (!statuses.contains(a.status)) throw new ApiException(400, "Status must be one of: " + String.join(", ", statuses));
        if (!DEPTHS.contains(a.depth)) throw new ApiException(400, "Build depth must be one of: " + String.join(", ", DEPTHS));
        if (!PHASES.contains(a.phase)) throw new ApiException(400, "Plan phase must be one of: " + String.join(", ", PHASES));
        if (!Util.VERSION.matcher(a.version).matches()) throw new ApiException(400, "Version must look like 1.2.0");
        for (String t : new String[]{a.summary, a.scenario, a.agentDoes, a.hardRule, a.dataPolicy, a.approverRole, a.domain})
            if (t.length() > 4000) throw new ApiException(400, "A text field is too long (limit 4000 characters)");
        if (a.sources.size() > 50) throw new ApiException(400, "Too many sources (limit 50)");
        for (Agent.Source s : a.sources) {
            if (s.name().length() > 300) throw new ApiException(400, "A source name is too long");
            if (!s.url().isBlank() && !s.url().matches("(?i)https?://\\S{1,2000}")) throw new ApiException(400, "Source links must start with http:// or https://");
        }
        if (a.contacts.size() > 50) throw new ApiException(400, "Too many contacts (limit 50)");
        for (Agent.Contact c : a.contacts) {
            if (c.name().length() > 120 || c.title().length() > 200) throw new ApiException(400, "A contact field is too long");
            if (!c.email().isBlank() && !Util.EMAIL.matcher(c.email()).matches()) throw new ApiException(400, "Contact email looks invalid: " + c.name());
        }
        if (a.tags.size() > 30) throw new ApiException(400, "Too many tags (limit 30)");
        if (a.testSetCount > 100000) throw new ApiException(400, "Test set size is out of range");
        if (!a.isTemplate()) {
            if (a.clientId.isBlank() || !clientIds.contains(a.clientId)) throw new ApiException(400, "Choose an existing client");
        }
        requireDemoReady(a);
    }

    private void validateClient(Client c) {
        if (c.id == null || !Util.ID.matcher(c.id).matches()) throw new ApiException(400, "Invalid client id");
        if (c.name.isBlank() || c.name.length() > 120) throw new ApiException(400, "Client name is required (120 characters at most)");
        if (!DEPTHS.contains(c.depth)) throw new ApiException(400, "Build depth must be one of: " + String.join(", ", DEPTHS));
        for (String t : new String[]{c.notes, c.sourcePolicy, c.approverRole, c.domain, c.shortName})
            if (t.length() > 1000) throw new ApiException(400, "A client field is too long");
    }

    /* ---------- writes ---------- */

    /** Applies only the fields callers may change. Governance, id, version and history are never taken from input. */
    private void apply(Agent a, Map<String, Object> b) {
        if (b.containsKey("name")) a.name = Util.str(b, "name", "").strip();
        if (b.containsKey("domain")) a.domain = Util.str(b, "domain", "").strip();
        if (b.containsKey("depth")) a.depth = Util.str(b, "depth", a.depth);
        if (b.containsKey("status")) a.status = Util.str(b, "status", a.status);
        if (b.containsKey("phase")) a.phase = Util.str(b, "phase", a.phase);
        if (b.containsKey("summary")) a.summary = Util.str(b, "summary", "").strip();
        if (b.containsKey("scenario")) a.scenario = Util.str(b, "scenario", "").strip();
        if (b.containsKey("agentDoes")) a.agentDoes = Util.str(b, "agentDoes", "").strip();
        if (b.containsKey("hardRule")) a.hardRule = Util.str(b, "hardRule", "").strip();
        if (b.containsKey("dataPolicy")) a.dataPolicy = Util.str(b, "dataPolicy", "").strip();
        if (b.containsKey("approverRole")) a.approverRole = Util.str(b, "approverRole", "").strip();
        if (b.containsKey("sources")) a.sources = Agent.parseSources(b.get("sources"));
        if (b.containsKey("contacts")) a.contacts = Agent.parseContacts(b.get("contacts"));
        if (b.containsKey("testSetCount")) a.testSetCount = Math.max(0, Util.integer(b, "testSetCount", a.testSetCount));
        if (b.containsKey("harnessAgent")) a.harnessAgent = Util.bool(b, "harnessAgent", a.harnessAgent);
        if (b.containsKey("harnessEval")) a.harnessEval = Util.bool(b, "harnessEval", a.harnessEval);
        if (b.containsKey("tags")) {
            a.tags = new ArrayList<>();
            for (Object t : Util.list(b, "tags")) if (t instanceof String s && !s.isBlank()) a.tags.add(s.strip());
        }
        if (b.containsKey("clientId") && !a.isTemplate()) a.clientId = Util.str(b, "clientId", a.clientId);
    }

    private void log(Agent a, String note) {
        a.updated = Util.today();
        a.history.add(0, new Agent.Entry(a.updated, a.version, Util.clip(note, 300)));
    }

    private String clientFor(Map<String, Object> b, String actor) {
        String clientId = Util.str(b, "clientId", "");
        String newName = Util.str(b, "newClientName", "").strip();
        if (clientId.isBlank() && !newName.isEmpty()) {
            Client c = new Client();
            c.id = uniqueId(newName, store.clients.keySet());
            c.name = newName;
            c.shortName = newName.split("\\s+")[0];
            c.domain = Util.str(b, "domain", "").strip();
            c.depth = DEPTHS.contains(Util.str(b, "depth", "")) ? Util.str(b, "depth", "") : "Scope tbc";
            c.approverRole = Util.str(b, "approverRole", "").strip();
            validateClient(c);
            store.save(c);
            store.audit(actor, "client.create", c.id, c.name);
            return c.id;
        }
        return clientId;
    }

    private static String uniqueId(String name, Set<String> taken) {
        String id;
        do { id = Util.slug(name) + "-" + Util.suffix(); } while (taken.contains(id));
        return id;
    }

    synchronized Agent create(Map<String, Object> b, String actor) {
        Agent a = new Agent();
        a.kind = "template".equals(Util.str(b, "kind", "agent")) ? "template" : "agent";
        a.status = a.isTemplate() ? "Draft" : "Concept";
        a.version = a.isTemplate() ? "1.0.0" : "0.1.0";
        apply(a, b);
        if (!a.isTemplate()) a.clientId = clientFor(b, actor);
        a.id = uniqueId(a.name.isBlank() ? "agent" : a.name, store.agents.keySet());
        a.history.clear();
        log(a, "Created");
        validate(a);
        store.save(a);
        store.audit(actor, "agent.create", a.id, a.name);
        return a;
    }

    synchronized Agent update(String id, Map<String, Object> b, String actor) {
        Agent a = agent(id).copy();
        String note = Util.clip(Util.str(b, "note", ""), 300);
        if (note.isBlank()) throw new ApiException(400, "Add a short note on what changed");
        boolean wasRetired = "Retired".equals(a.status);
        apply(a, b);
        if (!a.isTemplate() && b.containsKey("newClientName")) a.clientId = clientFor(b, actor);
        if (wasRetired && !"Retired".equals(a.status)) a.prevStatus = "";
        if (!wasRetired && "Retired".equals(a.status)) a.prevStatus = "";
        a.version = Util.bump(a.version, Util.bool(b, "major", false));
        log(a, note);
        validate(a);
        store.save(a);
        store.audit(actor, "agent.update", a.id, "v" + a.version + ": " + note);
        return a;
    }

    /** Quick update for harness flags and test-set size. Does not bump the version. */
    synchronized Agent patch(String id, Map<String, Object> b, String actor) {
        Agent a = agent(id).copy();
        Map<String, Object> allowed = new LinkedHashMap<>();
        for (String k : List.of("testSetCount", "harnessAgent", "harnessEval")) if (b.containsKey(k)) allowed.put(k, b.get(k));
        if (allowed.isEmpty()) throw new ApiException(400, "Nothing to update. Allowed: testSetCount, harnessAgent, harnessEval");
        apply(a, allowed);
        String note = Util.clip(Util.str(b, "note", "Quick update: " + String.join(", ", allowed.keySet())), 300);
        if (!a.isTemplate() && "Demo ready".equals(a.status) && checks(a).stream().anyMatch(c -> !c.ok())) {
            a.status = "In test";
            note += " (moved back to In test)";
        }
        log(a, note);
        validate(a);
        store.save(a);
        store.audit(actor, "agent.patch", a.id, note);
        return a;
    }

    synchronized Agent tailor(String baseId, Map<String, Object> b, String actor) {
        Agent base = agent(baseId);
        String clientId = clientFor(b, actor);
        if (clientId.isBlank() || !store.clients.containsKey(clientId)) throw new ApiException(400, "Choose an existing client or give newClientName");
        Client c = store.clients.get(clientId);
        Agent a = new Agent();
        a.kind = "agent";
        a.clientId = clientId;
        a.baseId = base.id;
        a.baseVersion = base.version;
        a.name = base.name;
        a.domain = c.domain.isBlank() ? base.domain : c.domain;
        a.depth = c.depth;
        a.summary = base.summary;
        a.scenario = base.scenario;
        a.agentDoes = base.agentDoes;
        a.hardRule = base.hardRule;
        a.dataPolicy = base.dataPolicy;
        a.approverRole = c.approverRole.isBlank() ? base.approverRole : c.approverRole;
        a.sources = new ArrayList<>(base.sources);
        a.tags = new ArrayList<>(base.tags);
        a.status = "Concept";
        a.version = "0.1.0";
        Map<String, Object> over = new LinkedHashMap<>(b);
        over.remove("clientId"); over.remove("status"); over.remove("kind");
        apply(a, over);   // contacts start empty unless supplied: a template's people are rarely the client's
        a.id = uniqueId(a.name, store.agents.keySet());
        a.history.clear();
        log(a, "Tailored from " + base.name + " v" + base.version);
        validate(a);
        store.save(a);
        store.audit(actor, "agent.tailor", a.id, "from " + base.id + " v" + base.version + " for " + c.id);
        return a;
    }

    synchronized Agent setRetired(String id, boolean retire, String actor) {
        Agent a = agent(id).copy();
        if (retire) {
            if ("Retired".equals(a.status)) return a;
            a.prevStatus = a.status;
            a.status = "Retired";
        } else {
            if (!"Retired".equals(a.status)) return a;
            a.status = !a.prevStatus.isBlank() && !"Retired".equals(a.prevStatus) ? a.prevStatus : (a.isTemplate() ? "Draft" : "Concept");
            a.prevStatus = "";
        }
        a.version = Util.bump(a.version, false);
        log(a, retire ? "Retired" : "Restored to " + a.status);
        store.save(a);
        store.audit(actor, retire ? "agent.retire" : "agent.restore", a.id, a.name);
        return a;
    }

    synchronized Agent markReviewed(String id, String actor) {
        Agent a = agent(id).copy();
        Agent base = a.baseId.isBlank() ? null : store.agents.get(a.baseId);
        if (base == null) throw new ApiException(400, "This agent has no template to review against");
        a.baseVersion = base.version;
        log(a, "Reviewed against " + base.name + " v" + base.version);
        store.save(a);
        store.audit(actor, "agent.reviewed", a.id, "base v" + base.version);
        return a;
    }

    synchronized Client createClient(Map<String, Object> b, String actor) {
        Client c = Client.fromMap(b);
        c.id = uniqueId(c.name.isBlank() ? "client" : c.name, store.clients.keySet());
        validateClient(c);
        store.save(c);
        store.audit(actor, "client.create", c.id, c.name);
        return c;
    }

    synchronized Client updateClient(String id, Map<String, Object> b, String actor) {
        Client old = client(id);
        Map<String, Object> merged = old.toMap();
        for (String k : List.of("name", "short", "domain", "depth", "approverRole", "sourcePolicy", "notes"))
            if (b.containsKey(k)) merged.put(k, b.get(k));
        merged.put("id", old.id);
        Client c = Client.fromMap(merged);
        validateClient(c);
        store.save(c);
        store.audit(actor, "client.update", c.id, c.name);
        return c;
    }

    /* ---------- export and import ---------- */

    Map<String, Object> export() {
        List<Object> cs = new ArrayList<>();
        store.clients.values().stream().sorted(Comparator.comparing(c -> c.id)).forEach(c -> cs.add(c.toMap()));
        List<Object> as = new ArrayList<>();
        store.agents.values().stream().sorted(Comparator.comparing(a -> a.id)).forEach(a -> {
            Map<String, Object> m = a.toMap();
            m.put("schema", "domainbrain.agent/v1");
            m.put("governance", Agent.governance());
            as.add(m);
        });
        return Agent.orderedMap("schema", "domainbrain.registry/v1", "exportedAt", Util.now(), "clients", cs, "agents", as);
    }

    synchronized Map<String, Object> importAll(Map<String, Object> body, String actor) {
        List<Client> cs = new ArrayList<>();
        List<Agent> as = new ArrayList<>();
        for (Object o : Util.list(body, "clients")) {
            Map<String, Object> m = Util.map(o);
            if (m == null) continue;
            Client c = Client.fromMap(m);
            validateClient(c);
            cs.add(c);
        }
        Object single = body.get("agents") == null && body.get("id") != null ? body : null;
        List<Object> raw = single != null ? List.of(single) : Util.list(body, "agents");
        for (Object o : raw) {
            Map<String, Object> m = Util.map(o);
            if (m == null) continue;
            as.add(Agent.fromMap(m));
        }
        if (cs.isEmpty() && as.isEmpty()) throw new ApiException(400, "No agents or clients found in the import");
        // Validate everything first so a bad file changes nothing.
        Set<String> clientIds = new HashSet<>(store.clients.keySet());
        cs.forEach(c -> clientIds.add(c.id));
        for (Agent a : as) {
            validate(a, clientIds);
        }
        cs.forEach(store::save);
        as.forEach(store::save);
        store.audit(actor, "registry.import", "-", as.size() + " agents, " + cs.size() + " clients");
        return Agent.orderedMap("agents", as.size(), "clients", cs.size());
    }
}

