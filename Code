package com.domainbrain.registry;

import java.nio.file.Path;

/** Domain Brain registry: a repository of agents with governance, readiness and human approval built in. */
public final class Main {
    private Main() {}

    public static void main(String[] args) throws Exception {
        String bind = LlmClient.env("BIND", "127.0.0.1");
        int port = Integer.parseInt(LlmClient.env("PORT", "8080"));
        Path dir = Path.of(LlmClient.env("REGISTRY_DIR", "registry"));
        boolean allowPrivate = "true".equalsIgnoreCase(LlmClient.env("ALLOW_PRIVATE_FETCH", "false"));

        Store store = new Store(dir);
        LlmClient llm = LlmClient.fromEnv();
        Registry registry = new Registry(store);
        ReviewService reviews = new ReviewService(store, llm, new SourceFetcher(allowPrivate));
        Server server = new Server(registry, store, reviews, llm, System.getenv("REGISTRY_WRITE_TOKEN"));
        int actual = server.start(bind, port);

        System.out.println("Domain Brain registry is running at http://" + (bind.equals("0.0.0.0") ? "localhost" : bind) + ":" + actual);
        System.out.println("Registry folder : " + dir.toAbsolutePath() + " (" + store.agents.size() + " agents, " + store.clients.size() + " clients)");
        System.out.println("Language model  : " + (llm.live() ? "LIVE, model " + llm.model() : "MOCK mode (set ANTHROPIC_API_KEY for real drafts)"));
        System.out.println("Write protection: " + (System.getenv("REGISTRY_WRITE_TOKEN") == null || System.getenv("REGISTRY_WRITE_TOKEN").isBlank()
                ? "OFF (anyone who can reach this server can edit; set REGISTRY_WRITE_TOKEN)" : "ON"));
    }
}

