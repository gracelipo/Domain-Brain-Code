package com.domainbrain.registry;

import java.io.ByteArrayOutputStream;
import java.io.IOException;
import java.io.InputStream;
import java.net.InetAddress;
import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.nio.charset.StandardCharsets;
import java.time.Duration;
import java.util.Locale;

/**
 * Retrieves the text of a public source. Refuses private, loopback and link-local addresses
 * (including after redirects) so the registry cannot be used to probe an internal network.
 */
final class SourceFetcher {
    private static final int MAX_BYTES = 2_000_000;
    static final int MAX_CHARS = 12_000;

    private final boolean allowPrivate;
    private final HttpClient http = HttpClient.newBuilder()
            .followRedirects(HttpClient.Redirect.NEVER)
            .connectTimeout(Duration.ofSeconds(8)).build();

    SourceFetcher(boolean allowPrivate) { this.allowPrivate = allowPrivate; }

    String fetch(String url) throws IOException {
        URI u = URI.create(url);
        for (int hop = 0; hop < 4; hop++) {
            check(u);
            HttpRequest req = HttpRequest.newBuilder(u).timeout(Duration.ofSeconds(15))
                    .header("User-Agent", "DomainBrainRegistry/1.0")
                    .header("Accept", "text/html,text/plain,application/json,application/xml").GET().build();
            HttpResponse<InputStream> r;
            try {
                r = http.send(req, HttpResponse.BodyHandlers.ofInputStream());
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
                throw new IOException("interrupted");
            }
            int code = r.statusCode();
            if (code >= 300 && code < 400) {
                String loc = r.headers().firstValue("location").orElseThrow(() -> new IOException("redirect without a location"));
                u = u.resolve(loc);
                r.body().close();
                continue;
            }
            if (code != 200) { r.body().close(); throw new IOException("HTTP " + code); }
            String ct = r.headers().firstValue("content-type").orElse("text/plain").toLowerCase(Locale.ROOT);
            if (!(ct.startsWith("text/") || ct.contains("json") || ct.contains("xml"))) {
                r.body().close();
                throw new IOException("unsupported content type " + ct.split(";")[0]);
            }
            try (InputStream in = r.body()) {
                ByteArrayOutputStream bos = new ByteArrayOutputStream();
                byte[] buf = new byte[8192];
                int n;
                while ((n = in.read(buf)) > 0) {
                    bos.write(buf, 0, n);
                    if (bos.size() > MAX_BYTES) break;
                }
                String text = bos.toString(StandardCharsets.UTF_8);
                if (ct.contains("html") || ct.contains("xml")) text = stripMarkup(text);
                text = text.replaceAll("\\s+", " ").strip();
                return text.length() > MAX_CHARS ? text.substring(0, MAX_CHARS) : text;
            }
        }
        throw new IOException("too many redirects");
    }

    private void check(URI u) throws IOException {
        String scheme = u.getScheme() == null ? "" : u.getScheme().toLowerCase(Locale.ROOT);
        if (!scheme.equals("http") && !scheme.equals("https")) throw new IOException("only http and https links are allowed");
        if (u.getHost() == null) throw new IOException("link has no host");
        if (allowPrivate) return;
        for (InetAddress a : InetAddress.getAllByName(u.getHost())) {
            byte[] b = a.getAddress();
            boolean uniqueLocal6 = b.length == 16 && (b[0] & 0xfe) == 0xfc;
            if (a.isAnyLocalAddress() || a.isLoopbackAddress() || a.isLinkLocalAddress() || a.isSiteLocalAddress()
                    || a.isMulticastAddress() || uniqueLocal6) {
                throw new IOException("link points to a private address");
            }
        }
    }

    static String stripMarkup(String html) {
        return html.replaceAll("(?is)<(script|style|noscript)[^>]*>.*?</\\1>", " ")
                .replaceAll("(?s)<!--.*?-->", " ")
                .replaceAll("(?s)<[^>]+>", " ")
                .replace("&nbsp;", " ").replace("&amp;", "&").replace("&lt;", "<").replace("&gt;", ">")
                .replace("&quot;", "\"").replace("&#39;", "'");
    }
}

