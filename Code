package com.domainbrain.registry;

import java.util.*;

/** One run of an agent: a draft that waits for a named human before it can be released. */
final class Review {
    static final String PENDING = "PENDING_APPROVAL";
    static final String APPROVED = "APPROVED";
    static final String RETURNED = "RETURNED";
    static final String DECLINED = "DECLINED_DONT_KNOW";   // the agent said "I don't know"
    static final String BLOCKED = "BLOCKED";              // harness rejected the draft

    String id;
    String agentId;
    String agentVersion;
    String question;
    String status;
    String draft = "";
    List<String> citations = new ArrayList<>();
    List<String> unsure = new ArrayList<>();
    List<String> flags = new ArrayList<>();
    List<String> sourcesUsed = new ArrayList<>();
    String model = "";
    boolean mock;
    String createdAt = Util.now();
    String createdBy = "";
    String decidedBy = "";
    String decidedAt = "";
    String decisionNote = "";

    @SuppressWarnings("unchecked")
    static Review fromMap(Map<String, Object> m) {
        Review r = new Review();
        r.id = Util.str(m, "id", null);
        r.agentId = Util.str(m, "agentId", "");
        r.agentVersion = Util.str(m, "agentVersion", "");
        r.question = Util.str(m, "question", "");
        r.status = Util.str(m, "status", BLOCKED);
        r.draft = Util.str(m, "draft", "");
        r.citations = strings(m.get("citations"));
        r.unsure = strings(m.get("unsure"));
        r.flags = strings(m.get("flags"));
        r.sourcesUsed = strings(m.get("sourcesUsed"));
        r.model = Util.str(m, "model", "");
        r.mock = Util.bool(m, "mock", false);
        r.createdAt = Util.str(m, "createdAt", "");
        r.createdBy = Util.str(m, "createdBy", "");
        r.decidedBy = Util.str(m, "decidedBy", "");
        r.decidedAt = Util.str(m, "decidedAt", "");
        r.decisionNote = Util.str(m, "decisionNote", "");
        return r;
    }

    static List<String> strings(Object o) {
        List<String> out = new ArrayList<>();
        if (o instanceof List<?> l) for (Object x : l) if (x != null) out.add(String.valueOf(x));
        return out;
    }

    Map<String, Object> toMap() {
        return Agent.orderedMap("id", id, "agentId", agentId, "agentVersion", agentVersion, "question", question,
                "status", status, "draft", draft, "citations", citations, "unsure", unsure, "flags", flags,
                "sourcesUsed", sourcesUsed, "model", model, "mock", mock, "createdAt", createdAt, "createdBy", createdBy,
                "decidedBy", decidedBy, "decidedAt", decidedAt, "decisionNote", decisionNote);
    }
}

