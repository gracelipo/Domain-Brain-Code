#!/usr/bin/env bash
# Builds domain-brain-registry.jar with only the JDK (17 or newer). No Maven or downloads needed.
set -euo pipefail
cd "$(dirname "$0")"
rm -rf out && mkdir out
javac --release 17 -Xlint:all -d out $(find src/main/java -name '*.java')
cp -r src/main/resources/web out/
jar --create --file domain-brain-registry.jar --main-class com.domainbrain.registry.Main -C out .
echo "Built domain-brain-registry.jar"

