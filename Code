package com.domainbrain.registry;

import java.util.*;

/** An agent or a reusable template. Governance is not a field: it is built in and always on. */
final class Agent {
    record Source(String name, String url) {}
    record Contact(String name, String type, String title, String email) {}
    record Entry(String at, String v, String note) {}

    String id;
    String kind = "agent";            // agent | template
    String name = "";
    String clientId = "";
    String baseId = "";
    String baseVersion = "";
    String domain = "Cross-industry";
    String depth = "Scope tbc";
    String status = "Concept";
    String prevStatus = "";
    String phase = "Days 1-30";
    String version = "0.1.0";
    String summary = "";
    String scenario = "";
    String agentDoes = "";
    String hardRule = "";
    String dataPolicy = "Public sources and synthetic data only";
    String approverRole = "";
    List<Source> sources = new ArrayList<>();
    List<Contact> contacts = new ArrayList<>();
    int testSetCount = 0;
    boolean harnessAgent = false;
    boolean harnessEval = false;
    List<String> tags = new ArrayList<>();
    List<Entry> history = new ArrayList<>();
    String updated = Util.today();

    boolean isTemplate() { return "template".equals(kind); }

    /** Deep copy. Changes are made on a copy and stored only after validation passes. */
    Agent copy() { return fromMap(toMap()); }

    static Agent fromMap(Map<String, Object> m) {
        Agent a = new Agent();
        a.id = Util.str(m, "id", null);
        a.kind = "template".equals(Util.str(m, "kind", "agent")) ? "template" : "agent";
        a.name = Util.str(m, "name", "").strip();
        a.clientId = Util.str(m, "clientId", "");
        a.baseId = Util.str(m, "baseId", "");
        a.baseVersion = Util.str(m, "baseVersion", "");
        a.domain = Util.str(m, "domain", a.domain);
        a.depth = Util.str(m, "depth", a.depth);
        a.status = Util.str(m, "status", a.isTemplate() ? "Draft" : "Concept");
        a.prevStatus = Util.str(m, "prevStatus", "");
        a.phase = Util.str(m, "phase", a.phase);
        a.version = Util.str(m, "version", a.isTemplate() ? "1.0.0" : "0.1.0");
        a.summary = Util.str(m, "summary", "");
        a.scenario = Util.str(m, "scenario", "");
        a.agentDoes = Util.str(m, "agentDoes", "");
        a.hardRule = Util.str(m, "hardRule", "");
        a.dataPolicy = Util.str(m, "dataPolicy", a.dataPolicy);
        a.approverRole = Util.str(m, "approverRole", "");
        a.sources = parseSources(m.get("sources"));
        a.contacts = parseContacts(m.get("contacts"));
        a.testSetCount = Math.max(0, Util.integer(m, "testSetCount", 0));
        a.harnessAgent = Util.bool(m, "harnessAgent", false);
        a.harnessEval = Util.bool(m, "harnessEval", false);
        a.tags = new ArrayList<>();
        for (Object t : Util.list(m, "tags")) if (t instanceof String s && !s.isBlank()) a.tags.add(s.strip());
        a.history = new ArrayList<>();
        for (Object h : Util.list(m, "history")) {
            Map<String, Object> hm = Util.map(h);
            if (hm != null) a.history.add(new Entry(Util.str(hm, "at", ""), Util.str(hm, "v", ""), Util.str(hm, "note", "")));
        }
        a.updated = Util.str(m, "updated", Util.today());
        return a;
    }

    static List<Source> parseSources(Object o) {
        List<Source> out = new ArrayList<>();
        if (o instanceof List<?> l) {
            for (Object x : l) {
                Map<String, Object> sm = Util.map(x);
                if (sm == null) continue;
                String n = Util.str(sm, "name", "").strip();
                if (!n.isEmpty()) out.add(new Source(n, Util.str(sm, "url", "").strip()));
            }
        }
        return out;
    }

    static List<Contact> parseContacts(Object o) {
        List<Contact> out = new ArrayList<>();
        if (o instanceof List<?> l) {
            for (Object x : l) {
                Map<String, Object> cm = Util.map(x);
                if (cm == null) continue;
                String n = Util.str(cm, "name", "").strip();
                if (n.isEmpty()) continue;
                String type = "POC".equals(Util.str(cm, "type", "SME")) ? "POC" : "SME";
                out.add(new Contact(n, type, Util.str(cm, "title", "").strip(), Util.str(cm, "email", "").strip()));
            }
        }
        return out;
    }

    Map<String, Object> toMap() {
        Map<String, Object> m = new LinkedHashMap<>();
        m.put("id", id);
        m.put("kind", kind);
        m.put("name", name);
        m.put("clientId", clientId);
        m.put("baseId", baseId);
        m.put("baseVersion", baseVersion);
        m.put("domain", domain);
        m.put("depth", depth);
        m.put("status", status);
        m.put("prevStatus", prevStatus);
        m.put("phase", phase);
        m.put("version", version);
        m.put("summary", summary);
        m.put("scenario", scenario);
        m.put("agentDoes", agentDoes);
        m.put("hardRule", hardRule);
        m.put("dataPolicy", dataPolicy);
        m.put("approverRole", approverRole);
        List<Object> src = new ArrayList<>();
        for (Source s : sources) src.add(orderedMap("name", s.name(), "url", s.url()));
        m.put("sources", src);
        List<Object> con = new ArrayList<>();
        for (Contact c : contacts) con.add(orderedMap("name", c.name(), "type", c.type(), "title", c.title(), "email", c.email()));
        m.put("contacts", con);
        m.put("testSetCount", testSetCount);
        m.put("harnessAgent", harnessAgent);
        m.put("harnessEval", harnessEval);
        m.put("tags", new ArrayList<>(tags));
        List<Object> hist = new ArrayList<>();
        for (Entry e : history) hist.add(orderedMap("at", e.at(), "v", e.v(), "note", e.note()));
        m.put("history", hist);
        m.put("updated", updated);
        return m;
    }

    static Map<String, Object> orderedMap(Object... kv) {
        Map<String, Object> m = new LinkedHashMap<>();
        for (int i = 0; i < kv.length; i += 2) m.put(String.valueOf(kv[i]), kv[i + 1]);
        return m;
    }

    /** Governance block included in exports. It is constant: it cannot be switched off. */
    static Map<String, Object> governance() {
        return orderedMap("citesEverySource", true, "logsEveryAction", true, "humanApprovesFirst", true, "saysIDontKnow", true);
    }
}

