package com.domainbrain.registry;

import java.io.IOException;
import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.time.Duration;
import java.util.*;

/**
 * Thin client for the Anthropic Messages API. The key comes only from the environment
 * (ANTHROPIC_API_KEY) and is never logged or returned by the API.
 */
final class LlmClient {
    private final String apiKey;
    private final String model;
    private final String baseUrl;
    private final HttpClient http = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(10)).build();

    LlmClient(String apiKey, String model, String baseUrl) {
        this.apiKey = apiKey == null ? "" : apiKey.strip();
        this.model = model;
        this.baseUrl = baseUrl.replaceAll("/+$", "");
    }

    static LlmClient fromEnv() {
        return new LlmClient(System.getenv("ANTHROPIC_API_KEY"),
                env("ANTHROPIC_MODEL", "claude-sonnet-5-5"),
                env("ANTHROPIC_BASE_URL", "https://api.anthropic.com"));
    }

    static String env(String k, String def) {
        String v = System.getenv(k);
        return v == null || v.isBlank() ? def : v.strip();
    }

    boolean live() { return !apiKey.isEmpty(); }
    String model() { return live() ? model : "mock"; }

    /** Sends one user message with a system prompt and returns the model's text. */
    String complete(String system, String user) {
        if (!live()) throw new ApiException(503, "No ANTHROPIC_API_KEY is configured");
        Map<String, Object> body = Agent.orderedMap(
                "model", model,
                "max_tokens", 1500,
                "system", system,
                "messages", List.of(Agent.orderedMap("role", "user", "content", user)));
        HttpRequest req = HttpRequest.newBuilder(URI.create(baseUrl + "/v1/messages"))
                .timeout(Duration.ofSeconds(60))
                .header("content-type", "application/json")
                .header("x-api-key", apiKey)
                .header("anthropic-version", "2023-06-01")
                .POST(HttpRequest.BodyPublishers.ofString(Json.write(body)))
                .build();
        HttpResponse<String> resp = send(req);
        if (resp.statusCode() == 429 || resp.statusCode() >= 500) {
            try { Thread.sleep(1500); } catch (InterruptedException e) { Thread.currentThread().interrupt(); }
            resp = send(req);
        }
        if (resp.statusCode() != 200) {
            String detail = "";
            try {
                Map<String, Object> err = Util.map(Json.parseObject(resp.body()).get("error"));
                if (err != null) detail = ": " + Util.clip(Util.str(err, "message", ""), 200);
            } catch (Exception ignored) { }
            throw new ApiException(502, "The language model request failed (HTTP " + resp.statusCode() + ")" + detail);
        }
        StringBuilder text = new StringBuilder();
        try {
            for (Object block : Util.list(Json.parseObject(resp.body()), "content")) {
                Map<String, Object> bm = Util.map(block);
                if (bm != null && "text".equals(bm.get("type"))) text.append(Util.str(bm, "text", ""));
            }
        } catch (Exception e) {
            throw new ApiException(502, "The language model returned an unreadable response");
        }
        return text.toString();
    }

    private HttpResponse<String> send(HttpRequest req) {
        try {
            return http.send(req, HttpResponse.BodyHandlers.ofString());
        } catch (IOException e) {
            throw new ApiException(502, "Could not reach the language model service");
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
            throw new ApiException(502, "The language model request was interrupted");
        }
    }
}

