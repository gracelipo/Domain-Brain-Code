#!/usr/bin/env bash
# Starts the registry. Settings are read from ./.env if it exists (see .env.example).
set -euo pipefail
cd "$(dirname "$0")"
if [ -f .env ]; then set -a; . ./.env; set +a; fi
[ -f domain-brain-registry.jar ] || ./build.sh
exec java -jar domain-brain-registry.jar

