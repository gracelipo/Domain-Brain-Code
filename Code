package com.domainbrain.registry;

import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.nio.file.*;
import java.util.*;
import java.util.concurrent.ConcurrentHashMap;
import java.util.stream.Stream;

/**
 * File-backed store. Every agent, client and review is one pretty-printed JSON file,
 * so the registry folder can live in Git and be reviewed like code.
 */
final class Store {
    final Path root;
    final Map<String, Agent> agents = new ConcurrentHashMap<>();
    final Map<String, Client> clients = new ConcurrentHashMap<>();
    final Map<String, Review> reviews = new ConcurrentHashMap<>();
    private final Object auditLock = new Object();

    Store(Path root) throws IOException {
        this.root = root;
        Files.createDirectories(root.resolve("agents"));
        Files.createDirectories(root.resolve("clients"));
        Files.createDirectories(root.resolve("reviews"));
        load();
    }

    private void load() throws IOException {
        for (Path p : jsonFiles("clients")) {
            try { Client c = Client.fromMap(Json.parseObject(Files.readString(p))); if (c.id != null) clients.put(c.id, c); }
            catch (Exception e) { System.err.println("Skipping unreadable client file " + p.getFileName() + ": " + e.getMessage()); }
        }
        for (Path p : jsonFiles("agents")) {
            try { Agent a = Agent.fromMap(Json.parseObject(Files.readString(p))); if (a.id != null) agents.put(a.id, a); }
            catch (Exception e) { System.err.println("Skipping unreadable agent file " + p.getFileName() + ": " + e.getMessage()); }
        }
        for (Path p : jsonFiles("reviews")) {
            try { Review r = Review.fromMap(Json.parseObject(Files.readString(p))); if (r.id != null) reviews.put(r.id, r); }
            catch (Exception e) { System.err.println("Skipping unreadable review file " + p.getFileName() + ": " + e.getMessage()); }
        }
    }

    private List<Path> jsonFiles(String dir) throws IOException {
        try (Stream<Path> s = Files.list(root.resolve(dir))) {
            return s.filter(p -> p.getFileName().toString().endsWith(".json")).sorted().toList();
        }
    }

    synchronized void save(Agent a) { write("agents", a.id, a.toMap()); agents.put(a.id, a); }
    synchronized void save(Client c) { write("clients", c.id, c.toMap()); clients.put(c.id, c); }
    synchronized void save(Review r) { write("reviews", r.id, r.toMap()); reviews.put(r.id, r); }

    private void write(String dir, String id, Map<String, Object> body) {
        Util.requireId(id);
        try {
            Path target = root.resolve(dir).resolve(id + ".json");
            Path tmp = root.resolve(dir).resolve("." + id + ".tmp");
            Files.writeString(tmp, Json.pretty(body), StandardCharsets.UTF_8);
            try {
                Files.move(tmp, target, StandardCopyOption.REPLACE_EXISTING, StandardCopyOption.ATOMIC_MOVE);
            } catch (AtomicMoveNotSupportedException e) {
                Files.move(tmp, target, StandardCopyOption.REPLACE_EXISTING);
            }
        } catch (IOException e) {
            throw new ApiException(500, "Could not write to the registry folder");
        }
    }

    /** Append-only audit log, one JSON object per line. */
    void audit(String actor, String action, String ref, String detail) {
        Map<String, Object> line = Agent.orderedMap("at", Util.now(), "actor", Util.clip(actor, 80), "action", action,
                "ref", ref, "detail", Util.clip(detail, 500));
        synchronized (auditLock) {
            try {
                Files.writeString(root.resolve("audit.log"), Json.write(line) + "\n", StandardCharsets.UTF_8,
                        StandardOpenOption.CREATE, StandardOpenOption.APPEND);
            } catch (IOException e) {
                System.err.println("Could not write audit log: " + e.getMessage());
            }
        }
    }

    List<Map<String, Object>> readAudit(int limit) {
        Path p = root.resolve("audit.log");
        List<Map<String, Object>> out = new ArrayList<>();
        if (!Files.exists(p)) return out;
        synchronized (auditLock) {
            try {
                List<String> lines = Files.readAllLines(p, StandardCharsets.UTF_8);
                for (int i = Math.max(0, lines.size() - limit); i < lines.size(); i++) {
                    try { out.add(Json.parseObject(lines.get(i))); } catch (Exception ignored) { }
                }
            } catch (IOException e) {
                throw new ApiException(500, "Could not read the audit log");
            }
        }
        Collections.reverse(out);
        return out;
    }
}

