package com.domainbrain.registry;

import com.sun.net.httpserver.HttpExchange;
import com.sun.net.httpserver.HttpServer;

import java.io.IOException;
import java.io.InputStream;
import java.io.OutputStream;
import java.net.InetSocketAddress;
import java.net.URLDecoder;
import java.nio.charset.StandardCharsets;
import java.security.MessageDigest;
import java.util.*;
import java.util.concurrent.Executors;

/** HTTP API plus a small static web page. Reads are open; writes need the bearer token when one is configured. */
final class Server {
    private record Resp(int status, Object body) {}

    private static final int MAX_BODY = 1_000_000;

    private final Registry reg;
    private final Store store;
    private final ReviewService reviews;
    private final LlmClient llm;
    private final String writeToken;
    private HttpServer http;

    Server(Registry reg, Store store, ReviewService reviews, LlmClient llm, String writeToken) {
        this.reg = reg;
        this.store = store;
        this.reviews = reviews;
        this.llm = llm;
        this.writeToken = writeToken == null || writeToken.isBlank() ? null : writeToken;
    }

    int start(String bind, int port) throws IOException {
        http = HttpServer.create(new InetSocketAddress(bind, port), 0);
        http.createContext("/", this::handle);
        http.setExecutor(Executors.newFixedThreadPool(16));
        http.start();
        return http.getAddress().getPort();
    }

    void stop() { if (http != null) http.stop(0); }

    private void handle(HttpExchange ex) throws IOException {
        try {
            String path = ex.getRequestURI().getPath();
            String method = ex.getRequestMethod();
            if (!path.startsWith("/api/") && !path.equals("/api")) {
                serveStatic(ex, path, method);
                return;
            }
            String actor = actor(ex);
            boolean write = !(method.equals("GET") || method.equals("HEAD"));
            if (write && writeToken != null && !tokenOk(ex)) {
                send(ex, 401, Agent.orderedMap("error", "A valid bearer token is required to make changes"));
                return;
            }
            Map<String, String> query = query(ex.getRequestURI().getRawQuery());
            Map<String, Object> body = write ? readBody(ex) : new LinkedHashMap<>();
            String[] seg = path.length() <= 5 ? new String[0] : path.substring(5).split("/");
            Resp r = route(method, seg, query, body, actor);
            send(ex, r.status(), r.body());
        } catch (ApiException e) {
            send(ex, e.status, Agent.orderedMap("error", e.getMessage()));
        } catch (IllegalArgumentException e) {
            send(ex, 400, Agent.orderedMap("error", "Bad request: " + Util.clip(e.getMessage(), 200)));
        } catch (Exception e) {
            System.err.println("Unexpected error: " + e);
            send(ex, 500, Agent.orderedMap("error", "Internal error"));
        } finally {
            ex.close();
        }
    }

    private Resp route(String m, String[] s, Map<String, String> q, Map<String, Object> b, String actor) {
        int n = s.length;
        if (n == 1 && s[0].equals("health") && m.equals("GET")) {
            return ok(Agent.orderedMap("status", "ok", "llm", llm.live() ? "live" : "mock", "model", llm.model(),
                    "writeProtected", writeToken != null, "agents", store.agents.size(), "clients", store.clients.size()));
        }
        if (n >= 1 && s[0].equals("clients")) {
            if (n == 1 && m.equals("GET")) {
                List<Object> out = new ArrayList<>();
                store.clients.values().stream().sorted(Comparator.comparing(c -> c.name.toLowerCase(Locale.ROOT))).forEach(c -> out.add(c.toMap()));
                return ok(out);
            }
            if (n == 1 && m.equals("POST")) return new Resp(201, reg.createClient(b, actor).toMap());
            if (n == 2 && m.equals("GET")) return ok(reg.client(s[1]).toMap());
            if (n == 2 && m.equals("PUT")) return ok(reg.updateClient(s[1], b, actor).toMap());
        }
        if (n >= 1 && s[0].equals("agents")) {
            if (n == 1 && m.equals("GET")) return ok(reg.list(q));
            if (n == 1 && m.equals("POST")) return new Resp(201, reg.view(reg.create(b, actor)));
            if (n == 2 && m.equals("GET")) return ok(reg.view(reg.agent(s[1])));
            if (n == 2 && m.equals("PUT")) return ok(reg.view(reg.update(s[1], b, actor)));
            if (n == 2 && m.equals("PATCH")) return ok(reg.view(reg.patch(s[1], b, actor)));
            if (n == 3 && m.equals("POST")) {
                switch (s[2]) {
                    case "tailor": return new Resp(201, reg.view(reg.tailor(s[1], b, actor)));
                    case "retire": return ok(reg.view(reg.setRetired(s[1], true, actor)));
                    case "restore": return ok(reg.view(reg.setRetired(s[1], false, actor)));
                    case "mark-reviewed": return ok(reg.view(reg.markReviewed(s[1], actor)));
                    case "reviews": return new Resp(201, reviews.run(s[1], b, actor).toMap());
                    default: break;
                }
            }
            if (n == 3 && m.equals("GET") && s[2].equals("reviews")) {
                reg.agent(s[1]);
                List<Object> out = new ArrayList<>();
                for (Review r : reviews.forAgent(s[1])) out.add(r.toMap());
                return ok(out);
            }
        }
        if (n >= 2 && s[0].equals("reviews")) {
            if (n == 2 && m.equals("GET")) return ok(reviews.get(s[1]).toMap());
            if (n == 3 && m.equals("GET") && s[2].equals("released")) return ok(reviews.released(s[1]));
            if (n == 3 && m.equals("POST") && s[2].equals("approve")) return ok(reviews.decide(s[1], true, b, actor).toMap());
            if (n == 3 && m.equals("POST") && s[2].equals("return")) return ok(reviews.decide(s[1], false, b, actor).toMap());
        }
        if (n == 1 && s[0].equals("export") && m.equals("GET")) return ok(reg.export());
        if (n == 1 && s[0].equals("import") && m.equals("POST")) return ok(reg.importAll(b, actor));
        if (n == 1 && s[0].equals("audit") && m.equals("GET")) {
            int limit = 100;
            try { limit = Math.max(1, Math.min(1000, Integer.parseInt(q.getOrDefault("limit", "100")))); } catch (NumberFormatException ignored) { }
            return ok(store.readAudit(limit));
        }
        throw new ApiException(404, "Not found");
    }

    private static Resp ok(Object o) { return new Resp(200, o); }

    private boolean tokenOk(HttpExchange ex) {
        String h = ex.getRequestHeaders().getFirst("Authorization");
        if (h == null || !h.regionMatches(true, 0, "Bearer ", 0, 7)) return false;
        byte[] given = h.substring(7).strip().getBytes(StandardCharsets.UTF_8);
        return MessageDigest.isEqual(given, writeToken.getBytes(StandardCharsets.UTF_8));
    }

    /** Self-declared name for the audit trail. It is a label, not authentication. */
    private static String actor(HttpExchange ex) {
        String a = ex.getRequestHeaders().getFirst("X-Actor");
        if (a == null) return "anonymous";
        a = a.replaceAll("[\\p{Cntrl}]", "").strip();
        return a.isEmpty() ? "anonymous" : Util.clip(a, 80);
    }

    private static Map<String, String> query(String raw) {
        Map<String, String> m = new LinkedHashMap<>();
        if (raw == null || raw.isEmpty()) return m;
        for (String part : raw.split("&")) {
            int i = part.indexOf('=');
            String k = URLDecoder.decode(i < 0 ? part : part.substring(0, i), StandardCharsets.UTF_8);
            String v = i < 0 ? "" : URLDecoder.decode(part.substring(i + 1), StandardCharsets.UTF_8);
            m.put(k, v);
        }
        return m;
    }

    private static Map<String, Object> readBody(HttpExchange ex) throws IOException {
        try (InputStream in = ex.getRequestBody()) {
            byte[] data = in.readNBytes(MAX_BODY + 1);
            if (data.length > MAX_BODY) throw new ApiException(413, "Request body is too large");
            String s = new String(data, StandardCharsets.UTF_8).strip();
            if (s.isEmpty()) return new LinkedHashMap<>();
            return Json.parseObject(s);
        }
    }

    private void send(HttpExchange ex, int status, Object body) throws IOException {
        byte[] out = Json.write(body).getBytes(StandardCharsets.UTF_8);
        setHeaders(ex, "application/json; charset=utf-8");
        ex.sendResponseHeaders(status, out.length);
        try (OutputStream os = ex.getResponseBody()) { os.write(out); }
    }

    private static void setHeaders(HttpExchange ex, String type) {
        ex.getResponseHeaders().set("Content-Type", type);
        ex.getResponseHeaders().set("Cache-Control", "no-store");
        ex.getResponseHeaders().set("X-Content-Type-Options", "nosniff");
        ex.getResponseHeaders().set("Referrer-Policy", "no-referrer");
        ex.getResponseHeaders().set("Content-Security-Policy", "default-src 'self'; style-src 'self'; script-src 'self'; frame-ancestors 'none'");
    }

    private void serveStatic(HttpExchange ex, String path, String method) throws IOException {
        if (!method.equals("GET") && !method.equals("HEAD")) throw new ApiException(405, "Method not allowed");
        String name = path.equals("/") ? "index.html" : path.substring(1);
        if (!List.of("index.html", "app.js", "app.css").contains(name)) throw new ApiException(404, "Not found");
        try (InputStream in = Server.class.getResourceAsStream("/web/" + name)) {
            if (in == null) throw new ApiException(404, "Not found");
            byte[] data = in.readAllBytes();
            String type = name.endsWith(".js") ? "text/javascript; charset=utf-8" : name.endsWith(".css") ? "text/css; charset=utf-8" : "text/html; charset=utf-8";
            setHeaders(ex, type);
            ex.sendResponseHeaders(200, method.equals("HEAD") ? -1 : data.length);
            if (!method.equals("HEAD")) try (OutputStream os = ex.getResponseBody()) { os.write(data); }
        }
    }
}
