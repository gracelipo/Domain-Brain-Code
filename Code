    }

    var hist = h('ul', { class: 'plain' });
    a.history.forEach(function (x) { hist.appendChild(h('li', null, (x.v ? 'v' + x.v + '  ' : '') + x.at + '  ' + x.note)); });
    card.appendChild(section('History', hist));
    d.appendChild(card);
  }

  function reviewCard(r, a) {
    var box = h('div', { class: 'review' });
    box.appendChild(h('div', null, h('b', { class: 'status-' + r.status }, r.status.replace(/_/g, ' ')), '  ' + r.createdAt + (r.mock ? '  (mock mode)' : '  (' + r.model + ')')));
    box.appendChild(h('div', { class: 'meta' }, 'Question: ' + r.question));
    box.appendChild(h('pre', null, r.draft));
    if (r.citations.length) box.appendChild(h('div', null, 'Cites: ' + r.citations.join(', ')));
    r.unsure.forEach(function (u) { box.appendChild(h('div', { class: 'flag' }, 'Unsure: ' + u)); });
    r.flags.forEach(function (f) { box.appendChild(h('div', { class: 'flag' }, 'Harness: ' + f)); });
    if (r.decidedBy) box.appendChild(h('div', { class: 'meta' }, (r.status === 'APPROVED' ? 'Approved by ' : 'Returned by ') + r.decidedBy + (r.decisionNote ? ': ' + r.decisionNote : '')));
    if (r.status === 'PENDING_APPROVAL') {
      var row = h('div', { class: 'actions' });
      row.appendChild(h('button', { class: 'primary', onclick: function () {
        var who = prompt('Your name (the ' + (a.approverRole || 'approver') + ' approving this draft):', $('#actor').value);
        if (who) act('POST', '/reviews/' + r.id + '/approve', { approver: who }, a.id);
      } }, 'Approve and release'));
      row.appendChild(h('button', { onclick: function () {
        var who = prompt('Your name:', $('#actor').value); if (!who) return;
        var note = prompt('What needs to change?'); if (!note) return;
        act('POST', '/reviews/' + r.id + '/return', { approver: who, note: note }, a.id);
      } }, 'Send back'));
      box.appendChild(row);
    }
    return box;
  }

  function act(method, path, body, reselect) {
    return api(method, path, body).then(function () { toast('Done'); return loadClients(); })
      .then(function () { return reselect ? select(reselect) : loadList(); }).catch(fail);
  }

  function runReview(a) {
    var q = prompt('What should the agent look into? (Use synthetic or public information only.)'); if (!q) return;
    var needText = a.sources.every(function (s) { return !s.url; });
    var body = { question: q };
    if (needText) {
      var txt = prompt('None of this agent\'s sources has a link. Paste the relevant public text from "' + a.sources.map(function (s) { return s.name; }).join('" or "') + '" (or leave blank and the agent will say it does not know):');
      if (txt && a.sources.length) body.passages = [{ source: a.sources[0].name, text: txt }];
    }
    toast('Running. This can take a few seconds.');
    api('POST', '/agents/' + a.id + '/reviews', body).then(function () { select(a.id); }).catch(fail);
  }

  function tailor(a) {
    var names = state.clients.map(function (c) { return c.name; }).join(', ');
    var c = prompt('Tailor "' + a.name + '" for which client?\nExisting: ' + names + '\n(Type an existing name, or a new one to create it.)'); if (!c) return;
    var found = state.clients.filter(function (x) { return x.name.toLowerCase() === c.trim().toLowerCase(); })[0];
    var name = prompt('Name for the new agent:', a.name); if (!name) return;
    var body = { name: name };
    if (found) body.clientId = found.id; else body.newClientName = c.trim();
    api('POST', '/agents/' + a.id + '/tailor', body).then(function (n) { toast('Created ' + n.name); return loadClients().then(function () { select(n.id); }); }).catch(fail);
  }

  ['kind', 'client', 'status', 'sort'].forEach(function (k) { $('#' + k).addEventListener('change', function () { loadList().catch(fail); }); });
  var timer; $('#q').addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(function () { loadList().catch(fail); }, 200); });
  ['actor', 'token'].forEach(function (k) {
    var el = $('#' + k); el.value = sessionStorage.getItem(k) || '';
    el.addEventListener('change', function () { sessionStorage.setItem(k, el.value); });
  });

  loadHealth();
  loadClients().then(loadList).catch(fail);
})();
